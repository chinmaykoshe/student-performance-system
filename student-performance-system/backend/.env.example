PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/student-performance-db

JWT_SECRET=replace_with_strong_random_string
JWT_EXPIRE=30d
JWT_RESET_SECRET=replace_with_another_random_string

ML_API_URL=http://127.0.0.1:8000

CLIENT_URL=http://localhost:5173

# ── Gemini AI (optional — uses rule-based fallback if blank) ──
GEMINI_API_KEY=

# ── Token Limits (free Gemini defaults) ──────────────────────
TOKEN_SESSION_LIMIT=8000
TOKEN_DAILY_USER=20000
TOKEN_DAILY_APP=80000

# ── Google OAuth (optional) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Nodemailer SMTP (optional — console fallback if blank) ────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Student Performance System" <noreply@studentprediction.com>
